*.swp
*.swo

# ─────────────────────────────────────────────────────────────
#  MediaPipe model weights — 29 MB.
#  NOT committed: Hugging Face requires Git LFS for files over 10 MB.
#  The Docker image downloads it at build time (see Dockerfile), and
#  utils/landmarks.py auto-downloads it locally on first run, so
#  nothing breaks by leaving it out of git.
# ─────────────────────────────────────────────────────────────
*.task

# ─────────────────────────────────────────────────────────────
#  Kept deliberately (do NOT ignore):
#    frontend/public/demo/*.json — the pre-generated demo reports
#      that power the instant sample-report mode. ~12 MB total,
#      committed on purpose so the demo works with no backend.
# ─────────────────────────────────────────────────────────────
